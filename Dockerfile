# 1. Берем официальный легкий образ с Python 3.9
FROM python:3.9-slim

# 2. Создаем внутри контейнера папку /app и делаем её рабочей
WORKDIR /app

# 3. Копируем ВСЕ файлы из текущей папки на компьютере в папку /app внутри контейнера
# (Это захватит и log_analyzer.py, и server.log)
COPY . .

# 4. Говорим контейнеру, какую команду выполнить при запуске
CMD ["python3", "log_analyzer.py"]